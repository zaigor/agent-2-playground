# Nothing here is needed for scanning: the scanner only reads public endpoints.
# These are the secrets a future *executor* would need. Never commit real values;
# put them in the environment's secrets, and use a dedicated wallet that holds
# only the trading budget.

# Polymarket (global), used only by `python -m pm_scanner lp --live` (memo section 18).
# The signer is a fresh wallet that holds nothing else; the Polymarket account it owns
# holds only the test budget. The SDK derives its CLOB credentials from the key at start.
POLY_PRIVATE_KEY=            # private key of the signer wallet (never commit a value)
POLY_WALLET=                 # the Polymarket account wallet address (profile menu on polymarket.com)
POLY_RELAYER_KEY=            # Settings -> API Keys -> Relayer API Keys on polymarket.com
POLY_RELAYER_ADDRESS=        # the "Signer Address" shown next to that relayer key

# Kalshi: API key id + RSA private key generated in account settings.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Hard cap: `lp` refuses a --budget above this, in dollars.
MAX_BUDGET_USD=50
